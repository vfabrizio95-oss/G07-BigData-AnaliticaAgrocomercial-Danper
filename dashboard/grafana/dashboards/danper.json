          "rawSql": "SELECT to_char(publicado_en, 'DD/MM/YYYY HH24:MI:SS') AS \"Publicado\", filas AS \"Filas\" FROM gold.control_publicacion WHERE tabla = 'abastecimiento_mayorista' ORDER BY publicado_en DESC LIMIT 10"
