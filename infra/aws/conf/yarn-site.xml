<?xml version="1.0" encoding="UTF-8"?>
<!--
  Danper G07 - YARN del cluster AWS.
  Dimensionado para workers de 2 vCPU y 8 GB (m7i-flex.large o similar):
  YARN reparte 6 GB y 2 núcleos por worker; el resto queda para el sistema
  operativo, el DataNode y el NodeManager. Si se usa otro tipo de instancia,
  ajustar memory-mb, cpu-vcores y spark-defaults.conf.
-->
<configuration>
  <!-- ResourceManager en el master -->
  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>MASTER_HOST</value>
  </property>
  <property>
    <name>yarn.resourcemanager.bind-host</name>
    <value>0.0.0.0</value>
  </property>
  <!-- Recursos que cada worker ofrece a YARN -->
  <property>
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>6144</value>
  </property>
  <property>
    <name>yarn.nodemanager.resource.cpu-vcores</name>
    <value>2</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-mb</name>
    <value>6144</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-vcores</name>
    <value>2</value>
  </property>
  <!-- Sin esto YARN mata los executors de Spark por memoria virtual -->
  <property>
    <name>yarn.nodemanager.vmem-check-enabled</name>
    <value>false</value>
  </property>
  <!-- Servicio de shuffle para trabajos MapReduce (Hadoop Streaming) -->
  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
  </property>
  <!-- Los logs de cada aplicación se juntan en HDFS para revisarlos desde el master -->
  <property>
    <name>yarn.log-aggregation-enable</name>
    <value>true</value>
  </property>
  <property>
    <name>yarn.nodemanager.remote-app-log-dir</name>
    <value>/danper/yarn-logs</value>
  </property>
  <!-- Límite de la caché local de archivos de aplicaciones (por defecto 10 GB):
       los discos de 20 GB se llenaban y los NodeManager quedaban UNHEALTHY.
       YARN borra lo más antiguo al pasar este tamaño. -->
  <property>
    <name>yarn.nodemanager.localizer.cache.target-size-mb</name>
    <value>2048</value>
  </property>
</configuration>
